# Platform data root shared by every Tradeq repository (required).
TRADEQ_DATA_DIR=/absolute/path/to/Tradeq/data
# Optional: alternative YAML defaults file.
# BT_CONFIG_FILE=/absolute/path/to/settings.yaml
# Optional: git sha recorded in trials when git is unavailable.
# BT_CODE_VERSION=
# Any setting can be overridden with BT_<SECTION>__<KEY>, for example:
# BT_SERVICE__PORT=8606
# BT_LEDGER__BASE_URL=http://127.0.0.1:8601
# BT_LEDGER__MODE=auto
# BT_PIT__BASE_URL=http://127.0.0.1:8603
# BT_PIT__MODE=local
# BT_SIM__BASE_URL=http://127.0.0.1:8609
# BT_SIM__MODE=fake
